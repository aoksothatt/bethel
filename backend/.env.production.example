APP_NAME="Bethel High School Jersey Tracker"
APP_ENV=production
# Set to your secure production key from Render Environment Variables:
APP_KEY=base64:REPLACE_WITH_YOUR_EXISTING_OR_NEW_PRODUCTION_KEY
APP_DEBUG=false
APP_URL=https://bethel-fm51.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logging (stderr streams directly into Render Dashboard Logs)
LOG_CHANNEL=stderr

# Database Configuration (TiDB Cloud Serverless)
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=test
DB_USERNAME=4GwwkAqZVDHJ3ch.root
DB_PASSWORD=your_tidb_password_here
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Session & Cache (Cookie-based session prevents database dependency on web routes)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# CORS Configuration (Explicit origins; avoid wildcard * when credentials are supported)
CORS_ALLOWED_ORIGINS=https://bethel-fm51.onrender.com,http://localhost:5173,http://127.0.0.1:5173
