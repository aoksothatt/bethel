APP_NAME="Bethel High School Jersey Tracker"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://your-service.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database Configuration (MySQL / TiDB Cloud Serverless for Production)
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=test
DB_USERNAME=your_tidb_username.root
DB_PASSWORD=your_secure_password
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Initial Admin Credentials
ADMIN_NAME="Team Administrator"
ADMIN_EMAIL=admin@teamjersey.local
ADMIN_PASSWORD=admin12345

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# CORS Configuration (Set to your frontend URL or *)
CORS_ALLOWED_ORIGINS=*
